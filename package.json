{
  "name": "cytoscape-dagre",
  "version": "4.0.0",
  "description": "The Dagre layout for DAGs and trees for Cytoscape.js",
  "main": "dist/cytoscape-dagre.js",
  "module": "dist/cytoscape-dagre.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/cytoscape-dagre.mjs",
      "require": "./dist/cytoscape-dagre.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "test",
    "index.d.ts"
  ],
  "author": {
    "name": "Max Franz",
    "email": "maxkfranz@gmail.com"
  },
  "scripts": {
    "postpublish": "run-s gh-pages",
    "gh-pages": "gh-pages -d pages",
    "copyright": "update license",
    "prepublishOnly": "run-s build",
    "lint": "eslint src --ext .ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:js": "rolldown -c rolldown.config.mjs",
    "build": "run-s build:js build:types",
    "build:min": "rolldown -c rolldown.config.mjs",
    "build:release": "run-s build build:min copyright",
    "watch": "rolldown -c rolldown.config.mjs --watch",
    "test": "run-s check lint build test:types test:mocha verify:generated",
    "test:mocha": "mocha \"test/**/*.test.mjs\"",
    "test:types": "tsc --noEmit -p test/types/tsconfig.json",
    "verify:generated": "git diff --exit-code -- dist index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape.js-dagre.git"
  },
  "keywords": [
    "cytoscape",
    "cytoscape-extension"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cytoscape/cytoscape.js-dagre/issues"
  },
  "homepage": "https://github.com/cytoscape/cytoscape.js-dagre",
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "camelcase": "^6.0.0",
    "chai": "4.2.0",
    "cpy-cli": "^3.1.1",
    "cross-env": "^7.0.2",
    "cytoscape": "^3.2.22",
    "eslint": "^7.6.0",
    "gh-pages": "^5.0.0",
    "mocha": "8.1.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "rolldown": "^1.1.3",
    "typescript": "^5.4.0",
    "update": "^0.7.4",
    "updater-license": "^1.0.0"
  },
  "peerDependencies": {
    "cytoscape": "^3.2.22"
  }
}
